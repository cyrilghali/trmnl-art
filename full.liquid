{% assign titles = "Hans Holbein le Jeune — Les Ambassadeurs|Jan van Eyck — Les Époux Arnolfini|Johannes Vermeer — L'Art de la peinture|Hiroshi Yoshida — Les Cerisiers de Kumoi|Johannes Vermeer — L'Astronome|Pieter Bruegel l'Ancien — La Tour de Babel|Katsushika Hokusai — Le Fuji rouge|Rembrandt — Le Festin de Balthazar|Pieter Bruegel l'Ancien — Les Gros Poissons mangent les petits|Claude Monet — La Pie|Pieter Bruegel l'Ancien — Le Combat de Carnaval et Carême|Georges de La Tour — Le Tricheur à l'as de carreau|Vincent van Gogh — Amandier en fleurs|Moritz Retzsch — Les Joueurs d'échecs|Pieter Bruegel l'Ancien — Les Jeux d'enfants|D'après Jérôme Bosch — L'Escamoteur|Hasegawa Tōhaku — Pins (paravent gauche)|Vilhelm Hammershøi — Poussière dansant dans les rayons du soleil|Gustave Doré — L'Empyrée (Paradis, chant XXXI)|Claude Monet — Les Coquelicots|William Hogarth — Satire de la fausse perspective|Anonyme — La Gravure de Flammarion|Utagawa Hiroshige — Pleine lune à Takanawa|Jérôme Bosch — Le Jardin des délices|Diego Velázquez — Les Fileuses|Camille Corot — Souvenir de Mortefontaine|George Frederic Watts — L'Espérance|D'après Pieter Bruegel l'Ancien — La Chute d'Icare|Utagawa Kuniyoshi — Il a l'air féroce, mais c'est un brave homme|Utagawa Hiroshige — Neige nocturne à Kanbara|Giuseppe Arcimboldo — Le Bibliothécaire|Albrecht Dürer — Melencolia I|Claude Monet — Le Bassin aux nymphéas|Diego Velázquez — Les Ménines|Caspar David Friedrich — Le Moine au bord de la mer|Utagawa Hiroshige — Cerisiers en fleurs à Gotenyama|Caspar David Friedrich — Deux Hommes contemplant la lune|Gustave Courbet — L'Atelier du peintre|Vincent van Gogh — Champ de blé avec cyprès|Rembrandt — Philosophe en méditation|Pieter Bruegel l'Ancien — Les Proverbes flamands|Odilon Redon — L'Œil, comme un ballon bizarre, se dirige vers l'infini|Ivan Chichkine — Matin dans une forêt de pins|Albrecht Dürer — Le Rhinocéros|Jérôme Bosch — Les Sept Péchés capitaux|Utagawa Hiroshige — Lune d'automne à Ishiyama|Jérôme Bosch — La Nef des fous|Giorgione — La Tempête|Georges Seurat — Un dimanche après-midi à l'île de la Grande Jatte|Giuseppe Arcimboldo — Le Maraîcher|Caspar David Friedrich — Le Voyageur contemplant une mer de nuages|Hasegawa Tōhaku — Pins (paravent droit)|Paul Gauguin — D'où venons-nous ? Que sommes-nous ? Où allons-nous ?|W. E. Hill — Ma femme et ma belle-mère|Vincent van Gogh — La Nuit étoilée sur le Rhône" | split: "|" %}
{% assign count = names | size %}
{% assign hour = "now" | date: "%s" | divided_by: 3600 %}
{% assign pick = hour | modulo: count %}
{% assign name = names[pick] %}
{% assign src = "https://raw.githubusercontent.com/cyrilghali/trmnl-art/main/img/" | append: name | append: ".jpg" %}
{% assign note = "" %}
{% case name %}
  {% when "arnolfini" %}{% assign note = "Un marchand et sa femme dans leur chambre, à Bruges, en 1434. Regardez le miroir rond au fond : il montre le couple de dos, et deux personnes sur le seuil, là où vous vous tenez. L'une serait le peintre. Au-dessus, il a signé en latin « Jan van Eyck était ici », comme un témoin. Une seule bougie brûle en plein jour. Mariage, promesse ou souvenir ? Personne n'est d'accord." %}
  {% when "art-of-painting" %}{% assign note = "Un peintre, vu de dos, peint une jeune femme déguisée en Clio, muse de l'Histoire : couronne de laurier, trompette de la renommée, livre. Au mur, une carte des Pays-Bas d'avant la séparation du Nord et du Sud, barrée d'un pli. Vermeer n'a jamais vendu ce tableau, il l'a gardé toute sa vie. On ne voit jamais le visage du peintre. Est-ce lui, ou n'importe quel peintre ?" %}
  {% when "astronomer" %}{% assign note = "Un savant se penche sur un globe céleste, la main posée dessus comme pour faire tourner le ciel. Le livre ouvert sur la table existe : un traité d'Adriaan Metius sur l'observation des étoiles, ouvert à la page qui conseille de chercher l'inspiration auprès de Dieu. Vermeer en a peint un jumeau, Le Géographe, avec le même modèle. Où s'arrête la science, où commence le mystère ?" %}
  {% when "dust-motes" %}{% assign note = "Une pièce vide de l'appartement de Hammershøi, à Copenhague, en 1900. Personne, aucun meuble, une porte fermée, une fenêtre qui ne montre rien du dehors. La seule chose qui bouge, c'est la lumière, et la poussière qui danse dedans. Il a peint ces mêmes pièces encore et encore. Une pièce où il n'y a personne est-elle vraiment vide ?" %}
  {% when "empyrean" %}{% assign note = "Gravure de Gustave Doré pour le Paradis de Dante, 1868. Tout en bas, Dante et Béatrice, minuscules, lèvent les yeux vers la rose céleste : des anneaux d'anges qui tournent autour d'un seul point de lumière. Doré ne dessine jamais Dieu. Il dessine la lumière, et la foule qui l'entoure. Plus les cercles approchent du centre, moins on y voit." %}
  {% when "false-perspective" %}{% assign note = "Hogarth grave cette planche en 1754 pour ouvrir un traité de perspective. La légende prévient : qui dessine sans connaître la perspective tombera dans de telles absurdités. Comptez-les. À une fenêtre, une femme allume la pipe d'un homme sur une colline lointaine. Une enseigne pend entre deux maisons à des distances différentes. Les moutons grandissent en s'éloignant. Combien en trouvez-vous ?" %}
  {% when "hope" %}{% assign note = "Une femme aux yeux bandés est assise sur le globe terrestre. Elle joue d'une lyre dont il ne reste qu'une corde, et se penche pour entendre la dernière note. Au-dessus d'elle, une seule petite étoile. L'espérance, ici, n'a rien de joyeux : c'est écouter ce qui sonne encore. Un sermon sur ce tableau a donné son titre au livre de Barack Obama, L'Audace d'espérer." %}
  {% when "kuniyoshi-face" %}{% assign note = "Regardez bien : ce visage est fait de corps humains. Des personnages forment le nez, les joues, les yeux, la chevelure. Le titre de Kuniyoshi, vers 1847, est une blague lui aussi. De près, une foule. De loin, un seul visage. Lequel est le vrai tableau ?" %}
  {% when "librarian" %}{% assign note = "Arcimboldo construit cet homme avec ce qu'il possède : des livres pour le corps, un livre ouvert pour les cheveux, des plumeaux pour la barbe. Peint vers 1566 à la cour des Habsbourg, il se moquerait de ceux qui collectionnent les livres pour les montrer plutôt que pour les lire. Il n'a pas de visage à lui. Sommes-nous ce que nous lisons, ou ce que nous rangeons ?" %}
  {% when "melencolia" %}{% assign note = "Gravure de Dürer, 1514. Une figure ailée reste immobile au milieu des outils : compas, rabot, scie, clous, une sphère et une étrange pierre taillée que personne n'a vraiment expliquée. Derrière elle, un carré magique : chaque ligne, colonne et diagonale fait 34, et la dernière ligne cache l'année, 1514. Une comète et un arc-en-ciel éclairent la mer. Elle a tous les outils. Pourquoi ne commence-t-elle pas ?" %}
  {% when "meninas" %}{% assign note = "De qui est-ce le portrait ? L'infante Marguerite se tient parmi ses suivantes, deux nains et un chien. À gauche, Velázquez peint une immense toile qu'on ne voit pas. Dans le miroir du fond apparaissent le roi et la reine, à la place exacte où vous êtes. Alors, qui tout le monde regarde-t-il ? La croix rouge sur la poitrine du peintre a été ajoutée plus tard, quand il fut fait chevalier." %}
  {% when "redon-eye" %}{% assign note = "Odilon Redon, 1882, dans un album dédié à Edgar Poe. Un œil géant flotte comme une montgolfière au-dessus d'un marais plat. Il ne nous regarde pas : il se tourne vers le haut, vers l'infini. Redon dessinait au fusain et appelait ces images ses « noirs ». Que voit un œil qui se détourne du monde pour regarder le ciel ?" %}
  {% when "ship-of-fools" %}{% assign note = "Bosch, vers 1500. Un bateau que personne ne dirige : un arbre pour mât, une louche pour rame. Un moine et une religieuse chantent et tentent de mordre une galette pendue à un fil. À l'écart, un fou en costume boit, assis sur une branche. Le vrai fou, suggère Bosch, n'est pas celui qui porte le costume. Cherchez la chouette cachée dans le feuillage, tout en haut." %}
  {% when "tempest" %}{% assign note = "Giorgione, vers 1508. Un jeune homme debout à gauche, une femme qui allaite à droite, et entre eux un éclair au-dessus d'une ville. Personne ne sait ce que le tableau raconte : Giorgione n'a rien laissé d'écrit. Les rayons X ont montré qu'il avait d'abord peint une autre femme à la place du jeune homme. C'est peut-être le premier tableau dont le vrai sujet est l'orage, et l'humeur qu'il donne." %}
  {% when "vegetable-gardener" %}{% assign note = "Un bol d'oignons, de racines et de navets, peint par Arcimboldo vers 1590. Maintenant, penchez la tête à l'envers. Le bol devient un chapeau, les légumes un visage rubicond : le jardinier, fait de sa propre récolte. Un tableau qui a deux bons sens. Combien de choses que vous regardez chaque jour cachent un autre visage ?" %}
  {% when "wanderer" %}{% assign note = "Caspar David Friedrich, vers 1818. On ne voit l'homme que de dos : nous sommes à sa place, nous regardons ce qu'il regarde. Le paysage n'existe pas. Friedrich l'a composé avec des croquis de plusieurs sommets des montagnes de grès de l'Elbe. Le brouillard cache ce qui les sépare. À quoi pense-t-il ? Le tableau vous laisse répondre." %}
  {% when "wife-mother-in-law" %}{% assign note = "Premier regard : une jeune femme se détourne, une plume dans les cheveux, un ruban au cou. Second regard : une vieille femme de profil, le menton dans sa fourrure. Le menton de la jeune femme est le nez de la vieille ; son collier, sa bouche. W. E. Hill l'a publié en 1915. Une fois les deux vues, peut-on encore n'en voir qu'une ?" %}
{% endcase %}
{% if note != "" %}
{% assign credit = titles[pick] | split: " — " %}
<div class="layout" style="padding: 0; flex-direction: row; align-items: stretch; justify-content: flex-start;">
  <img class="image-dither" src="{{ src }}" style="height: 100%; width: auto; flex: none;">
  <div style="flex: 1; display: flex; flex-direction: column; justify-content: center; gap: 20px; padding: 0 36px;">
    <span class="label">{{ credit[0] }}</span>
    <span class="title title--large">{{ credit[1] }}</span>
    <p class="description" style="font-size: 19px; line-height: 1.45;">{{ note }}</p>
  </div>
</div>
{% else %}
<div class="layout" style="padding: 0;">
  <img class="image image-dither" src="{{ src }}" style="width: 100%; height: 100%; object-fit: contain;">
</div>
<div class="title_bar">
  <span class="title">{{ titles[pick] }}</span>
</div>
{% endif %}
